  "private": true,
  "scripts": {
    "build-preview": "sed -i 's|/status.json|https://mirrors.hust.edu.cn/status.json|g' src/pages/index.tsx && sed -i 's|/status.json|https://mirrors.hust.edu.cn/status.json|g' src/pages/syncing-status/index.tsx && sed -i 's|/releases.json|https://mirrors.hust.edu.cn/releases.json|g' src/pages/release.tsx && docusaurus build",
    "docusaurus": "docusaurus",
